# Mock mode is the default. Set to "false" to talk to Supabase.
NEXT_PUBLIC_USE_MOCK=true

# Public Supabase project values (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Never put an AI provider key here or in any NEXT_PUBLIC_ variable.
# AI keys live in Supabase Edge Function secrets, or in a server-only var
# read by a Route Handler under src/app/api/.
